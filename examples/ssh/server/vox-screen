#!/bin/sh
# vox-screen WIDTH HEIGHT FPS: this computer's X11 desktop as a stream of images on stdout, at most FPS a second. Exits
# when stdout closes. For the phone app (Vox) over SSH.
#   VOX_FORMAT=png VOX_SIZE=WxH (Vox 0.96+): lossless grey PNGs, the desktop shrunk once (Lanczos) to fit inside the
#   glasses' picture W x H, pixel for pixel on the glasses: sharper text than JPEGs shrunk twice.
#   Otherwise: baseline JPEGs scaled to fit inside WIDTH x HEIGHT (aspect kept).
#   VOX_DUAL=1 (Vox 1.23+, "Phone as the main screen"): the glasses get a monitor of their own above the laptop's
#   screen (vox-dual on, VOX_SIZE big: pixel for pixel) and only it is sent; the phone shows the laptop's screen.
#   It goes away 20 s after the last such stream ends (a reconnect in between keeps it).
set -eu
[ $# -eq 3 ] || { echo "usage: vox-screen WIDTH HEIGHT FPS" >&2; exit 2; }
W=$1 H=$2 FPS=$3
case "$W$H$FPS" in *[!0-9]*|'') echo "vox-screen: WIDTH HEIGHT FPS must be positive integers" >&2; exit 2;; esac
[ "$W" -gt 0 ] && [ "$H" -gt 0 ] && [ "$FPS" -gt 0 ] || { echo "vox-screen: values must be > 0" >&2; exit 2; }

# Over SSH there is no DISPLAY: use the logged-in desktop's.
export DISPLAY="${DISPLAY:-:0}"
if [ -z "${XAUTHORITY:-}" ]; then
	for f in "/run/user/$(id -u)/gdm/Xauthority" "$HOME/.Xauthority"; do
		[ -r "$f" ] && { export XAUTHORITY="$f"; break; }
	done
fi

dims=$(xdpyinfo 2>/dev/null | sed -n 's/^ *dimensions: *\([0-9]*\)x\([0-9]*\) pixels.*/\1 \2/p')
[ -n "$dims" ] || { echo "vox-screen: no X11 desktop on $DISPLAY (logged in? Wayland?)" >&2; exit 1; }
set -- $dims
SW=$1 SH=$2
CROP=""
BIN=$(dirname "$0")

if [ "${VOX_DUAL:-}" = 1 ]; then
	# Held (shared) while this stream lives: the last one gone, the glasses monitor goes after a grace.
	exec 8>"$HOME/.vox-dual.lock"
	flock -s 8
	"$BIN/vox-dual" on "${VOX_SIZE:-640x480}" >&2 || echo "vox-screen: no glasses monitor; the whole desktop" >&2
	grace_off() {
		setsid sh -c 'sleep 20; exec flock -n -x "$HOME/.vox-dual.lock" "$0" off' "$BIN/vox-dual" 8>&- >/dev/null 2>&1 </dev/null &
	}
	trap grace_off EXIT
	trap 'exit 0' HUP INT TERM PIPE
fi
if [ -f "$HOME/.vox-dual" ]; then
	read -r GW GH GX GY < "$HOME/.vox-dual" || true
	if [ -n "${GY:-}" ]; then
		SW=$GW SH=$GH CROP="startx=$GX starty=$GY endx=$((GX + GW - 1)) endy=$((GY + GH - 1))"
	fi
fi

if [ "${VOX_FORMAT:-}" = png ]; then
	VW=${VOX_SIZE%x*} VH=${VOX_SIZE#*x}
	case "$VW$VH" in *[!0-9]*|'') VW=$W VH=$H ;; esac
	[ "$VW" -gt 1 ] && [ "$VH" -gt 1 ] || { VW=$W; VH=$H; }
	if [ $((SW * VH)) -gt $((SH * VW)) ]; then OW=$VW OH=$((SH * VW / SW)); else OH=$VH OW=$((SW * VH / SH)); fi
	gst-launch-1.0 -q ximagesrc display-name="$DISPLAY" use-damage=false show-pointer=true $CROP \
		! "video/x-raw,framerate=$FPS/1" ! videoconvert ! "video/x-raw,format=GRAY8" ! videoscale method=lanczos \
		! "video/x-raw,width=$OW,height=$OH,pixel-aspect-ratio=1/1" \
		! pngenc compression-level=1 ! fdsink fd=1 sync=false
	exit
fi

# Fit inside W x H; even sizes for the JPEG encoder.
if [ $((SW * H)) -gt $((SH * W)) ]; then OW=$W OH=$((SH * W / SW)); else OH=$H OW=$((SW * H / SH)); fi
OW=$(((OW + 1) / 2 * 2)) OH=$(((OH + 1) / 2 * 2))

gst-launch-1.0 -q ximagesrc display-name="$DISPLAY" use-damage=false show-pointer=true $CROP \
	! "video/x-raw,framerate=$FPS/1" ! videoconvert ! videoscale \
	! "video/x-raw,width=$OW,height=$OH,pixel-aspect-ratio=1/1" \
	! jpegenc quality=80 ! fdsink fd=1 sync=false
