#!/usr/bin/env python3
"""Claude plan usage (the 5-hour and weekly limits, as Claude Code's /usage shows them), as one line of JSON for Vox's
dashboard: {"five": %, "five_reset": iso, "week": %, "week_reset": iso, "at": epoch} or {"error": ...}.
Uses the login Claude Code already keeps (~/.claude/.credentials.json); the token never leaves this phone except to
Anthropic. Cached 120 s (~/.cache/claude-usage.json) so polling stays light."""
import json, os, sys, time, urllib.request, urllib.error
CACHE = os.path.expanduser("~/.cache/claude-usage.json")
try:
    c = json.load(open(CACHE))
    if time.time() - c.get("at", 0) < 120 and "--fresh" not in sys.argv:
        print(json.dumps(c)); sys.exit(0)
except Exception:
    pass
def pct(v):
    if v is None: return None
    v = float(v)
    return round(v * 100 if v <= 1.0 else v)
try:
    tok = json.load(open(os.path.expanduser("~/.claude/.credentials.json")))["claudeAiOauth"]["accessToken"]
    req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
        "Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20", "User-Agent": "vox-usage"})
    d = json.load(urllib.request.urlopen(req, timeout=15))
    f, w = d.get("five_hour") or {}, d.get("seven_day") or {}
    out = {"five": pct(f.get("utilization")), "five_reset": f.get("resets_at"),
           "week": pct(w.get("utilization")), "week_reset": w.get("resets_at"), "at": int(time.time())}
except urllib.error.HTTPError as e:
    out = {"error": "login expired: open claude once" if e.code == 401 else "HTTP %d" % e.code, "at": int(time.time())}
except Exception as e:
    out = {"error": str(e)[:80], "at": int(time.time())}
os.makedirs(os.path.dirname(CACHE), exist_ok=True)
tmp = CACHE + ".tmp"; json.dump(out, open(tmp, "w")); os.replace(tmp, CACHE)
print(json.dumps(out))
